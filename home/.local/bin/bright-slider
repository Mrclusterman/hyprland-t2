#!/usr/bin/env python3
"""Popup estilo Centro de control de macOS con un slider, justo debajo del icono de waybar.
Uso: bright-slider screen|kbd|volume   (clic de nuevo en el icono o sacar el ratón = cerrar)"""
import sys
from barpopup import Gtk, run, window, label

def bl_get(dev):
    return lambda: int(run("brightnessctl", "-d", dev, "-m").split(",")[3].rstrip("%"))

def bl_set(dev, signal_waybar=False):
    def set_(v):
        run("brightnessctl", "-q", "-d", dev, "set", f"{v}%")
        if signal_waybar:
            run("pkill", "-RTMIN+8", "waybar")
    return set_

SINK = "@DEFAULT_AUDIO_SINK@"
KINDS = {  # título, icono, mínimo, leer, escribir
    "screen": ("Pantalla", "\U000f00df", 5, bl_get("acpi_video0"), bl_set("acpi_video0")),
    "kbd":    ("Teclado",  "",     0, bl_get("apple::kbd_backlight"), bl_set("apple::kbd_backlight", True)),
    "volume": ("Sonido",   "",     0,
               lambda: round(float(run("wpctl", "get-volume", SINK).split()[1]) * 100),
               lambda v: run("wpctl", "set-volume", "-l", "1", SINK, f"{v}%")),
}
kind = sys.argv[1] if len(sys.argv) > 1 else ""
if kind not in KINDS:
    sys.exit("uso: bright-slider screen|kbd|volume")
TITLE, ICON, MIN, get_value, set_value = KINDS[kind]
WIDTH = 280

win, inner = window(kind, WIDTH, """
.icon, .icon:backdrop { color: rgba(60, 60, 67, 0.85); font-family: "JetBrainsMono Nerd Font Propo"; font-size: 15px; margin-left: 10px; }
scale, scale:backdrop { padding: 0; margin: 0; min-height: 0; }
scale trough, scale trough:backdrop {
  min-height: 28px; border-radius: 14px; border: none; box-shadow: none;
  background: rgba(255, 255, 255, 0.16);
}
scale highlight, scale highlight:backdrop {
  min-height: 28px; border-radius: 14px; border: none; background: #f5f5f7;
}
scale slider, scale slider:backdrop {
  min-width: 0; min-height: 0; margin: 0; padding: 0;
  border: none; box-shadow: none; background: transparent;
}
""")
inner.add(label(TITLE, "title", xalign=0))

scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, MIN, 100, 1)
scale.set_draw_value(False)
scale.set_value(get_value())
scale.connect("value-changed", lambda s: set_value(int(s.get_value())))
# Icono dentro de la barra, a la izquierda (como en macOS)
overlay = Gtk.Overlay()
overlay.add(scale)
icon = label(ICON, "icon", halign=Gtk.Align.START, valign=Gtk.Align.CENTER)
overlay.add_overlay(icon)
overlay.set_overlay_pass_through(icon, True)
inner.add(overlay)

win.show_all()
Gtk.main()
