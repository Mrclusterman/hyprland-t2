#!/bin/sh
# Lanzador de Discord: el bootstrap sin ventana (--no-gui; antes --no-zenity, quitado por Discord); aquí sin zenity y en Wayland nativo
dir=$(/usr/share/discord/updater_bootstrap --no-gui "${HOME}/.config/discord" stable https://updates.discord.com/ 2>/dev/null) || exit 2
# Vídeo/streams por GPU (VA-API) en vez de CPU
exec "${HOME}/.config/discord/${dir}/Discord" --ozone-platform-hint=auto --enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,AcceleratedVideoEncoder "$@"
