#!/bin/sh
# Tras suspender (hypridle after_sleep_cmd): el teclado T2 se reconecta ~0,5 s después de la pantalla.
# Se espera a que reaparezca (como mucho 3 s) y entonces se enciende la pantalla, así todo vuelve a la vez.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"  # por si se lanza fuera de la sesión
export LC_ALL=C
t0=$(date +%s%N)
since=$(cat "${XDG_RUNTIME_DIR}/sleep-start" 2>/dev/null || echo "${t0}")  # teclado reconectado después de suspender
for _ in $(seq 30); do
  for k in /dev/input/by-id/*Apple_Internal_Keyboard*-event-kbd; do
    t=$(stat -c %.9Y "${k}" 2>/dev/null | tr -d .)
    [ -n "${t}" ] && [ "${t}" -gt "${since}" ] && break 2
  done
  sleep 0.1
done
hyprctl dispatch 'hl.dsp.dpms({action="on"})' >/dev/null
~/.local/bin/charger-check &  # avisa si el puerto USB-C deja de cargar tras suspender
