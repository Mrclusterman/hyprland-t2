#!/bin/sh
# Antes de suspender (hypridle before_sleep_cmd): bloquear y apagar la pantalla; resume-screen la enciende.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"  # por si se lanza fuera de la sesión
date +%s%N > "$XDG_RUNTIME_DIR/sleep-start"
loginctl lock-session
hyprctl dispatch 'hl.dsp.dpms({action="off"})' >/dev/null
